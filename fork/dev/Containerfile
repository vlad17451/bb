FROM docker.io/library/node:24.10.0-bookworm

RUN apt-get update \
 && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends nftables \
 && rm -rf /var/lib/apt/lists/*

ENV COREPACK_ENABLE_DOWNLOAD_PROMPT=0 \
    TURBO_TELEMETRY_DISABLED=1 \
    BB_TELEMETRY=false
RUN corepack enable \
 && corepack prepare pnpm@9.15.0 --activate \
 && pnpm config set --global store-dir /pnpm-store \
 && pnpm config set --global confirm-modules-purge false

COPY entrypoint.sh /usr/local/bin/bb-fork-dev-entrypoint
WORKDIR /repo
ENTRYPOINT ["/usr/local/bin/bb-fork-dev-entrypoint"]
CMD ["bash"]

{
  "name": "bb-plugin-provider-agy",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Run bb threads with Google Antigravity CLI.",
  "engines": {
    "bb": ">=0.0",
    "bbPluginSdk": ">=0.5.22"
  },
  "bb": {
    "name": "Antigravity provider",
    "description": "Run bb threads with Google Antigravity CLI.",
    "branding": {
      "icon": "./icons/agy.svg"
    },
    "server": "./server.ts",
    "host": "./src/host.ts",
    "experimental_providers": [
      {
        "kind": "agent",
        "id": "agy",
        "displayName": "Antigravity"
      }
    ]
  },
  "keywords": [
    "bb-plugin"
  ],
  "scripts": {
    "test": "vitest run --config vitest.config.ts",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --ignore-pattern node_modules --ignore-pattern dist .",
    "prepare:bundled": "bb-plugin-build prepare-bundled"
  },
  "dependencies": {
    "@get-bb/plugin-sdk": "workspace:*",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@bb/plugin-build": "workspace:*",
    "@types/node": "^22.0.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-7": "npm:typescript@^7.0.2",
    "vitest": "^4.1.1"
  }
}
